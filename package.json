{
  "name": "@ibbr-engineering/observability-browser",
  "version": "1.0.0",
  "description": "Privacy-safe browser RUM client for IBBR observability.",
  "type": "module",
  "sideEffects": false,
  "license": "Apache-2.0",
  "main": "dist/obs-browser.iife.js",
  "module": "dist/obs-browser.esm.js",
  "types": "src/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "import": "./dist/obs-browser.esm.js",
      "default": "./dist/obs-browser.iife.js"
    }
  },
  "files": [
    "dist",
    "src/index.d.ts",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "build": "node esbuild.mjs",
    "pretest": "npm run build",
    "test": "vitest",
    "typecheck": "tsc --noEmit --strict --lib ES2020,DOM src/index.d.ts",
    "test:browser": "playwright test test/browser.spec.js --project=chromium"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "esbuild": "0.25.9",
    "happy-dom": "20.11.6",
    "typescript": "5.9.2",
    "vitest": "3.2.7"
  }
}
